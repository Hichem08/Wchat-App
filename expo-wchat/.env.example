# Wchat Mobile App Environment Variables (React Native / Expo)
# DO NOT put SUPABASE_SERVICE_ROLE_KEY here. Only use the public ANON key.

# Supabase Project URL & Anonymous Public Key
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Socket.IO Real-Time Server URL
# In development on a physical Android phone, use your machine's local LAN IP:
# e.g., http://192.168.1.50:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
