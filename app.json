{
  "expo": {
    "name": "Wchat",
    "slug": "wchat-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/assets/aistudio/Wchat_45b83e7a.jpeg",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#080810",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wchat.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080810"
      },
      "package": "com.wchat.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.0"
          }
        }
      ]
    ]
  }
}
