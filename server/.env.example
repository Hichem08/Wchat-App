# Wchat Server Environment Variables
PORT=4000

# Supabase Credentials (keep service-role key SECRET on server only!)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Origin for CORS (e.g. * or your frontend domain / IP)
CLIENT_URL=*
